# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Set on the Convex deployment too; use this Clerk instance's issuer URL
CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Convex
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
# Optional for standard Convex Cloud; required for a custom deployment domain
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-project.convex.site
CONVEX_DEPLOY_KEY=prod:...

# Resend Email
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@furnishfinder.com
# Set on Convex: staff inbox for support case notifications
SUPPORT_EMAIL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Creem.io Payments
# Use creem_test_... for sandbox, creem_... for production
CREEM_API_KEY=creem_test_...
CREEM_WEBHOOK_SECRET=whsec_...
# Product IDs from Creem dashboard (set these in Convex env vars too)
CREEM_PRODUCT_LANDLORD_PRO=prod_...
CREEM_PRODUCT_LANDLORD_PREMIUM=prod_...
CREEM_PRODUCT_TENANT_PLUS=prod_...
CREEM_PRODUCT_FEATURE_LISTING=prod_...
